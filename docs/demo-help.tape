Output "docs/demo-help.gif"
Set FontSize 16
Set Width 760
Set Height 260
Set Theme "Dracula"
Set WindowBar Colorful
Set WindowBarSize 36

Type "export PS1='$ '"
Enter
Sleep 300ms

Type "export PATH=/tmp/swarm-rd-orchestrator-demo/.venv/bin:$PATH"
Enter
Sleep 300ms

Type "clear"
Enter
Sleep 300ms

Type "swarm-rd-cli --help"
Enter
Sleep 3s
